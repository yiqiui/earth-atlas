{
  "name": "earth-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "地表志 · 全球自然地貌三维图谱 / Global natural landform atlas",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:extract": "node scripts/extract-textures.mjs",
    "data:fetch": "node scripts/fetch-natural-earth.mjs",
    "data:thematic": "node scripts/generate-thematic.mjs && node scripts/fetch-climate.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/three": "^0.175.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
