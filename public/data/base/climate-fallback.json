{"type":"FeatureCollection","features":[{"type":"Feature","id":"tropical-rainforest","properties":{"name":"热带雨林气候","name_en":"Tropical rainforest","featurecla":"climate","zone":"tropical-rainforest","teaching":"赤道附近全年高温多雨，如亚马孙平原、刚果盆地、马来群岛。小学到高中重点。","name_zh":"热带雨林气候"},"geometry":{"type":"Polygon","coordinates":[[[-10,-60],[10,-62],[12,-50],[-8,-48],[-10,-60]]]}},{"type":"Feature","id":"tropical-monsoon","properties":{"name":"热带季风气候","name_en":"Tropical monsoon","featurecla":"climate","zone":"tropical-monsoon","teaching":"全年高温，分旱雨两季，主要分布在印度半岛和中南半岛。","name_zh":"热带季风气候"},"geometry":{"type":"Polygon","coordinates":[[[68,8],[88,8],[90,25],[78,28],[68,22],[68,8]]]}},{"type":"Feature","id":"tropical-desert","properties":{"name":"热带沙漠气候","name_en":"Tropical desert","featurecla":"climate","zone":"tropical-desert","teaching":"终年炎热干燥，如撒哈拉沙漠、阿拉伯半岛。回归线附近大陆内部和西岸。","name_zh":"热带沙漠气候"},"geometry":{"type":"Polygon","coordinates":[[[-17,15],[35,15],[35,32],[-17,32],[-17,15]]]}},{"type":"Feature","id":"temperate-continental","properties":{"name":"温带大陆性气候","name_en":"Temperate continental","featurecla":"climate","zone":"temperate-continental","teaching":"冬冷夏热、年温差大、降水少且集中夏季，分布于亚欧大陆和北美大陆内部。大学以上重点。","name_zh":"温带大陆性气候"},"geometry":{"type":"Polygon","coordinates":[[[35,40],[135,42],[140,60],[50,65],[35,55],[35,40]]]}},{"type":"Feature","id":"temperate-monsoon","properties":{"name":"温带季风气候","name_en":"Temperate monsoon","featurecla":"climate","zone":"temperate-monsoon","teaching":"夏季高温多雨、冬季寒冷干燥，分布于中国东部、朝鲜半岛、日本北部。","name_zh":"温带季风气候"},"geometry":{"type":"Polygon","coordinates":[[[105,33],[130,33],[135,48],[115,50],[105,42],[105,33]]]}},{"type":"Feature","id":"mediterranean","properties":{"name":"地中海气候","name_en":"Mediterranean","featurecla":"climate","zone":"mediterranean","teaching":"夏季炎热干燥、冬季温和多雨，是唯一雨热不同期的气候类型。","name_zh":"地中海气候"},"geometry":{"type":"Polygon","coordinates":[[[-9,30],[36,30],[36,45],[-9,45],[-9,30]]]}},{"type":"Feature","id":"temperate-maritime","properties":{"name":"温带海洋性气候","name_en":"Temperate maritime","featurecla":"climate","zone":"temperate-maritime","teaching":"全年温和湿润、降水均匀，受西风和暖流影响，典型如西欧。","name_zh":"温带海洋性气候"},"geometry":{"type":"Polygon","coordinates":[[[-12,40],[25,42],[30,58],[-12,58],[-12,40]]]}},{"type":"Feature","id":"plateau-mountain","properties":{"name":"高原山地气候","name_en":"Highland","featurecla":"climate","zone":"plateau-mountain","teaching":"垂直地带性显著，随海拔升高气候与植被呈垂直变化，青藏高原典型。","name_zh":"高原山地气候"},"geometry":{"type":"Polygon","coordinates":[[[75,28],[105,28],[105,40],[75,40],[75,28]]]}},{"type":"Feature","id":"polar","properties":{"name":"寒带气候","name_en":"Polar","featurecla":"climate","zone":"polar","teaching":"终年寒冷，长冬无夏，分布于北极圈以北和南极大陆。","name_zh":"寒带气候"},"geometry":{"type":"Polygon","coordinates":[[[-180,66],[180,66],[180,90],[-180,90],[-180,66]]]}}]}